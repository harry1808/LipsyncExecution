# Environment configuration for AI Video Dubbing
#
# 1) Copy this file to `.env` in the project root (same folder as `flask_app.py`).
# 2) Edit `.env`: the lines below WITHOUT a leading `#` are real keys — set your secret and save.
# 3) Lines that START with `#` are comments or optional examples — remove the `#` only if you need that variable.
#
# The Flask app loads `.env` automatically (python-dotenv). If `.env` is missing, defaults in code still run.

# --- Required for production (change the secret) ---
FLASK_SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=production

# --- Commonly set ---
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
# 1 = enable lip-sync by default on upload; 0 = off
LIPSYNC_DEFAULT=0

# --- Optional: gated Hugging Face models ---
# HF_TOKEN=hf_your_token_here










