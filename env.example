# Environment Configuration for AI Video Dubbing
# Copy this file to .env and customize values

# Flask Configuration
FLASK_SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=production

# Translation Model
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M

# Lip-sync Settings
# Set to 1 to enable lip-sync by default, 0 to disable
LIPSYNC_DEFAULT=0
# Optional: override Wav2Lip subprocess batch sizes (eBack inference.py). Both must be set if used.
# Higher = faster but more RAM. CPU defaults are 4 / 48; GPU uses 4 / 128. If unstable on CPU, try 4 / 32.
# WAV2LIP_FACE_DET_BATCH=4
# WAV2LIP_INFER_BATCH=32

# Hugging Face Token (optional, for gated models)
# HF_TOKEN=hf_your_token_here










